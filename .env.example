# Copy to .env and fill in. Never commit .env.

# --- Server -------------------------------------------------------------------
PORT=3001
# Long random string used to sign admin sessions. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Supabase (leave empty to run in local mode) ---------------------------------
# Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=
# The service_role key. Server-only: it bypasses Row Level Security. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The anon/public key (used only to check admin passwords via Supabase Auth).
SUPABASE_ANON_KEY=
# Storage bucket for product images (created by supabase/schema.sql).
SUPABASE_BUCKET=product-images
# Supabase Auth users allowed into /admin (comma-separated emails).
ADMIN_EMAILS=

# --- Local mode admin (used only when Supabase is not configured) -----------------
ADMIN_EMAIL=admin@glowglossary.in
ADMIN_PASSWORD=

# Optional: other origins allowed to call the admin API (comma-separated).
ALLOWED_ORIGINS=
