{
  "name": "glow-glossary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch-path=server --watch-path=shared server/index.js\" \"vite\"",
    "dev:api": "node --watch-path=server --watch-path=shared server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "images": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lenis": "^1.3.27",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "sharp": "^0.35.5",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5"
  },
  "description": "Glow Glossary storefront and admin: React + Express + Supabase",
  "engines": {
    "node": ">=20.12"
  }
}
